{
  "name": "fut-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ml:historical": "node scripts/historical-ml-reconstruction.cjs",
    "test:ml-historical": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/ml-historical.test.cjs tests/ml-shadow.test.cjs",
    "ml:export": "node --env-file=.env scripts/ml-dataset.cjs",
    "test:ml": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/ml-foundation.test.cjs",
    "test:ai-live-pipeline": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/ai-live-pipeline.test.cjs",
    "test:ai-chat": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/ai-chat.test.cjs",
    "test:ai": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/ai-api.test.cjs",
    "historical:backfill": "npm run historical:build && node scripts/football-data-backfill.cjs",
    "historical:epl-backfill": "npm run historical:build && node scripts/football-data-backfill.cjs",
    "historical:football-data": "node scripts/football-data-import.cjs",
    "historical:pilot": "node scripts/historical-pilot.cjs",
    "test:historical:provider": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/historical/provider.test.cjs",
    "historical:build": "tsc --project tsconfig.historical.json",
    "historical:worker": "node scripts/historical-worker.cjs",
    "test:historical": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/historical/foundation.test.cjs",
    "test:historical:db": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/historical/persistence.test.cjs",
    "test:point-in-time": "node --require ./tests/no-provider-http.cjs --require ./tests/register-typescript.cjs --test tests/training/point-in-time.test.cjs",
    "test:radar-review": "node --require ./tests/register-typescript.cjs --test tests/radar-review-now.test.cjs",
    "test:radar-hybrid-review": "node --require ./tests/register-typescript.cjs --test tests/radar-hybrid-review.test.cjs",
    "dataset:status": "node --env-file=.env scripts/dataset-status.cjs",
    "dataset:simulate-hybrid": "node --env-file=.env scripts/simulate-hybrid.cjs",
    "test:hybrid": "node --require ./tests/register-typescript.cjs --test tests/training/hybrid.test.cjs",
    "test:hybrid:db": "node --env-file=.env --require ./tests/register-typescript.cjs --test tests/training/hybrid.persistence.test.cjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "test:training": "node --require ./tests/register-typescript.cjs --test tests/training/features.test.cjs",
    "test:training:db": "node --env-file=.env --require ./tests/register-typescript.cjs --test tests/training/persistence.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "prisma": "^6.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
