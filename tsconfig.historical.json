{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "rootDir": "src",
    "outDir": ".historical-build"
  },
  "include": ["src/services/historical/**/*.ts"],
  "exclude": ["node_modules", ".historical-build"]
}
